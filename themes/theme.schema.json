        "markdown_wikilink_text": {"type":"string","title":"Wikilink text","description":"[[Note]] links and embeds; follows Link text.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
