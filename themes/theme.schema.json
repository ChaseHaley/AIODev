        "markdown_h2_background": {"type":"string","title":"Heading 2 background","description":"Behind level 2 headings; follows Heading background.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_h3_text": {"type":"string","title":"Heading 3 text","description":"Level 3 headings; follows Heading text.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_h3_background": {"type":"string","title":"Heading 3 background","description":"Behind level 3 headings; follows Heading background.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_h4_text": {"type":"string","title":"Heading 4 text","description":"Level 4 headings; follows Heading text.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_h4_background": {"type":"string","title":"Heading 4 background","description":"Behind level 4 headings; follows Heading background.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_h5_text": {"type":"string","title":"Heading 5 text","description":"Level 5 headings; follows Heading text.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_h5_background": {"type":"string","title":"Heading 5 background","description":"Behind level 5 headings; follows Heading background.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_h6_text": {"type":"string","title":"Heading 6 text","description":"Level 6 headings; follows Heading text.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_h6_background": {"type":"string","title":"Heading 6 background","description":"Behind level 6 headings; follows Heading background.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_link_text": {"type":"string","title":"Link text","description":"Links, autolinks and image descriptions.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
