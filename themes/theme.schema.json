{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIODev theme",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "colors"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 32},
    "name": {"type": "string", "description": "Display name shown in the theme selector; any text."},
    "author": {"type": "string"},
    "description": {"type": "string"},
    "base": {
      "type": "string",
      "description": "ID of another theme that supplies the colors this file leaves out.",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window": {"type":"string","title":"Window background","description":"Behind panes and around pane cards.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}$"},{"$ref":"#/$defs/colorReference"}]},
        "tab_bar": {"type":"string","title":"Tab bar background","description":"Title bar, horizontal tab strip and vertical tab rail.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}$"},{"$ref":"#/$defs/colorReference"}]},
        "tab_text": {"type":"string","title":"Tab text","description":"Titles and close buttons of inactive tabs.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}$"},{"$ref":"#/$defs/colorReference"}]},
        "tab_active": {"type":"string","title":"Active tab background","description":"The selected tab in the horizontal tab strip.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "tab_active_text": {"type":"string","title":"Active tab text","description":"Title of the selected tab.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}$"},{"$ref":"#/$defs/colorReference"}]},
        "tab_indicator": {"type":"string","title":"Active tab indicator","description":"Underline or bar marking the selected tab.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}$"},{"$ref":"#/$defs/colorReference"}]},
        "rail_active": {"type":"string","title":"Active vertical tab background","description":"The selected tab in the vertical tab rail.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "pane": {"type":"string","title":"Pane background","description":"Settings and other non-terminal panes.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}$"},{"$ref":"#/$defs/colorReference"}]},
        "pane_border": {"type":"string","title":"Pane border","description":"Outline of unfocused panes and shared split dividers.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "pane_focus": {"type":"string","title":"Focused pane border","description":"Outline of the focused pane.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "surface": {"type":"string","title":"Popup background","description":"Menus, the everything palette, notices and dialogs.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}$"},{"$ref":"#/$defs/colorReference"}]},
        "text": {"type":"string","title":"Text","description":"Primary interface text.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}$"},{"$ref":"#/$defs/colorReference"}]},
        "muted": {"type":"string","title":"Secondary text","description":"Labels, descriptions and inactive controls.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}$"},{"$ref":"#/$defs/colorReference"}]},
        "faint": {"type":"string","title":"Hint text","description":"Working directories, placeholders and hints.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}$"},{"$ref":"#/$defs/colorReference"}]},
        "accent": {"type":"string","title":"Accent","description":"Primary buttons, toggles, links and highlights.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}$"},{"$ref":"#/$defs/colorReference"}]},
        "accent_text": {"type":"string","title":"Text on accent","description":"Text drawn on accent fills.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}$"},{"$ref":"#/$defs/colorReference"}]},
        "border": {"type":"string","title":"Border","description":"Hairlines around controls, popups and headers.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "focus": {"type":"string","title":"Focus ring","description":"Keyboard focus outlines.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "selection": {"type":"string","title":"Selection highlight","description":"Selected list items, pressed toggles and marked tabs.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "success": {"type":"string","title":"Success","description":"Success notices and states.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}$"},{"$ref":"#/$defs/colorReference"}]},
        "warning": {"type":"string","title":"Warning","description":"Warning notices and states.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}$"},{"$ref":"#/$defs/colorReference"}]},
        "danger": {"type":"string","title":"Danger","description":"Errors and destructive actions.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}$"},{"$ref":"#/$defs/colorReference"}]},
        "info": {"type":"string","title":"Information","description":"Informational notices.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}$"},{"$ref":"#/$defs/colorReference"}]},
        "scrollbar_track": {"type":"string","title":"Scrollbar track","description":"Scrollbar track while the pointer is over it.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "scrollbar": {"type":"string","title":"Scrollbar","description":"Scrollbar thumb at rest.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "scrollbar_hover": {"type":"string","title":"Scrollbar hover","description":"Scrollbar thumb under the pointer.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "scrollbar_active": {"type":"string","title":"Scrollbar pressed","description":"Scrollbar thumb while dragged.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "code_background": {"type":"string","title":"Code background","description":"Code, inline code and frontmatter in Markdown panes.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "diff_added": {"type":"string","title":"Added lines","description":"Lines a change added in Agent changes.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "diff_removed": {"type":"string","title":"Removed lines","description":"Lines a change removed in Agent changes.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_paragraph_text": {"type":"string","title":"Paragraph text","description":"Body text in Markdown panes.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_paragraph_background": {"type":"string","title":"Paragraph background","description":"Behind Markdown paragraphs; none shows the pane.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_strong_text": {"type":"string","title":"Bold text","description":"Bold words; none keeps the text around.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_strong_background": {"type":"string","title":"Bold background","description":"Behind bold words.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_emphasis_text": {"type":"string","title":"Italic text","description":"Italic words; none keeps the text around.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_emphasis_background": {"type":"string","title":"Italic background","description":"Behind italic words.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_strike_text": {"type":"string","title":"Strikethrough text","description":"Struck-through words; none keeps the text around.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_strike_background": {"type":"string","title":"Strikethrough background","description":"Behind struck-through words.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_markup_text": {"type":"string","title":"Markup text","description":"Syntax such as # and ** on the line being edited.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_markup_background": {"type":"string","title":"Markup background","description":"Behind the syntax on the line being edited.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_heading_text": {"type":"string","title":"Heading text","description":"Every heading level without its own color; none keeps the text around.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_heading_background": {"type":"string","title":"Heading background","description":"Behind every heading level without its own.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
        "markdown_h1_text": {"type":"string","title":"Heading 1 text","description":"Level 1 headings; follows Heading text.","anyOf":[{"pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},{"$ref":"#/$defs/colorReference"}]},
