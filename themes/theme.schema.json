{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIODev Theme",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "base", "colors"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 32, "not": {"enum": ["studio","tide","ember","tokyonight-night","tokyonight-storm","tokyonight-moon"]}},
    "name": {"type": "string"},
    "author": {"type": "string"},
    "description": {"type": "string"},
    "base": {"enum": ["studio-dark","studio-light","tide-dark","tide-light","ember-dark","ember-light","tokyonight-night-dark","tokyonight-night-light","tokyonight-storm-dark","tokyonight-storm-light","tokyonight-moon-dark","tokyonight-moon-light"]},
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window": {"type":"string","title":"Window Background","description":"Behind panes and around pane cards.","pattern":"^#[0-9a-fA-F]{6}$"},
        "tab_bar": {"type":"string","title":"Tab Bar Background","description":"Title bar, horizontal tab strip and vertical tab rail.","pattern":"^#[0-9a-fA-F]{6}$"},
        "tab_text": {"type":"string","title":"Tab Text","description":"Titles and close buttons of inactive tabs.","pattern":"^#[0-9a-fA-F]{6}$"},
        "tab_active": {"type":"string","title":"Active Tab Background","description":"The selected tab in the horizontal tab strip.","pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},
        "tab_active_text": {"type":"string","title":"Active Tab Text","description":"Title of the selected tab.","pattern":"^#[0-9a-fA-F]{6}$"},
        "tab_indicator": {"type":"string","title":"Active Tab Indicator","description":"Underline or bar marking the selected tab.","pattern":"^#[0-9a-fA-F]{6}$"},
        "rail_active": {"type":"string","title":"Active Vertical Tab Background","description":"The selected tab in the vertical tab rail.","pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},
        "pane": {"type":"string","title":"Pane Background","description":"Settings and other non-terminal panes.","pattern":"^#[0-9a-fA-F]{6}$"},
        "pane_border": {"type":"string","title":"Pane Border","description":"Outline of unfocused panes and shared split dividers.","pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},
        "pane_focus": {"type":"string","title":"Focused Pane Border","description":"Outline of the focused pane.","pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},
        "surface": {"type":"string","title":"Popup Background","description":"Menus, the command palette, notices and dialogs.","pattern":"^#[0-9a-fA-F]{6}$"},
        "text": {"type":"string","title":"Text","description":"Primary interface text.","pattern":"^#[0-9a-fA-F]{6}$"},
        "muted": {"type":"string","title":"Secondary Text","description":"Labels, descriptions and inactive controls.","pattern":"^#[0-9a-fA-F]{6}$"},
        "faint": {"type":"string","title":"Hint Text","description":"Working directories, placeholders and hints.","pattern":"^#[0-9a-fA-F]{6}$"},
        "accent": {"type":"string","title":"Accent","description":"Primary buttons, toggles, links and highlights.","pattern":"^#[0-9a-fA-F]{6}$"},
        "accent_text": {"type":"string","title":"Text on Accent","description":"Text drawn on accent fills.","pattern":"^#[0-9a-fA-F]{6}$"},
        "border": {"type":"string","title":"Border","description":"Hairlines around controls, popups and headers.","pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},
        "focus": {"type":"string","title":"Focus Ring","description":"Keyboard focus outlines.","pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},
        "selection": {"type":"string","title":"Selection Highlight","description":"Selected list items, pressed toggles and marked tabs.","pattern":"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"},
        "success": {"type":"string","title":"Success","description":"Success notices and states.","pattern":"^#[0-9a-fA-F]{6}$"},
        "warning": {"type":"string","title":"Warning","description":"Warning notices and states.","pattern":"^#[0-9a-fA-F]{6}$"},
        "danger": {"type":"string","title":"Danger","description":"Errors and destructive actions.","pattern":"^#[0-9a-fA-F]{6}$"},
        "info": {"type":"string","title":"Information","description":"Informational notices.","pattern":"^#[0-9a-fA-F]{6}$"},
        "foreground": {"type":"string","title":"Foreground","description":"Default shell text.","pattern":"^#[0-9a-fA-F]{6}$"},
        "background": {"type":"string","title":"Background","description":"Default shell background and its pane card.","pattern":"^#[0-9a-fA-F]{6}$"},
        "cursor": {"type":"string","title":"Cursor","description":"Cursor color.","pattern":"^#[0-9a-fA-F]{6}$"},
        "cursor_text": {"type":"string","title":"Cursor Text","description":"Text under the block cursor.","pattern":"^#[0-9a-fA-F]{6}$"},
        "selection_background": {"type":"string","title":"Selection Background","description":"Background of selected text.","pattern":"^#[0-9a-fA-F]{6}$"},
        "selection_foreground": {"type":"string","title":"Selection Text","description":"Selected text color; empty keeps each cell's own color.","pattern":"^(#[0-9a-fA-F]{6})?$"},
        "search_foreground": {"type":"string","title":"Search Match Text","description":"Text of search matches.","pattern":"^#[0-9a-fA-F]{6}$"},
        "search_background": {"type":"string","title":"Search Match Background","description":"Background of search matches.","pattern":"^#[0-9a-fA-F]{6}$"},
        "search_selected_background": {"type":"string","title":"Selected Match Background","description":"Background of the selected search match.","pattern":"^#[0-9a-fA-F]{6}$"},
        "palette.0": {"type":"string","title":"ANSI Black","description":"ANSI palette color 0.","pattern":"^#[0-9a-fA-F]{6}$"},
        "palette.1": {"type":"string","title":"ANSI Red","description":"ANSI palette color 1.","pattern":"^#[0-9a-fA-F]{6}$"},
        "palette.2": {"type":"string","title":"ANSI Green","description":"ANSI palette color 2.","pattern":"^#[0-9a-fA-F]{6}$"},
        "palette.3": {"type":"string","title":"ANSI Yellow","description":"ANSI palette color 3.","pattern":"^#[0-9a-fA-F]{6}$"},
        "palette.4": {"type":"string","title":"ANSI Blue","description":"ANSI palette color 4.","pattern":"^#[0-9a-fA-F]{6}$"},
        "palette.5": {"type":"string","title":"ANSI Magenta","description":"ANSI palette color 5.","pattern":"^#[0-9a-fA-F]{6}$"},
        "palette.6": {"type":"string","title":"ANSI Cyan","description":"ANSI palette color 6.","pattern":"^#[0-9a-fA-F]{6}$"},
        "palette.7": {"type":"string","title":"ANSI White","description":"ANSI palette color 7.","pattern":"^#[0-9a-fA-F]{6}$"},
        "palette.8": {"type":"string","title":"ANSI Bright Black","description":"ANSI palette color 8.","pattern":"^#[0-9a-fA-F]{6}$"},
        "palette.9": {"type":"string","title":"ANSI Bright Red","description":"ANSI palette color 9.","pattern":"^#[0-9a-fA-F]{6}$"},
        "palette.10": {"type":"string","title":"ANSI Bright Green","description":"ANSI palette color 10.","pattern":"^#[0-9a-fA-F]{6}$"},
        "palette.11": {"type":"string","title":"ANSI Bright Yellow","description":"ANSI palette color 11.","pattern":"^#[0-9a-fA-F]{6}$"},
        "palette.12": {"type":"string","title":"ANSI Bright Blue","description":"ANSI palette color 12.","pattern":"^#[0-9a-fA-F]{6}$"},
        "palette.13": {"type":"string","title":"ANSI Bright Magenta","description":"ANSI palette color 13.","pattern":"^#[0-9a-fA-F]{6}$"},
        "palette.14": {"type":"string","title":"ANSI Bright Cyan","description":"ANSI palette color 14.","pattern":"^#[0-9a-fA-F]{6}$"},
        "palette.15": {"type":"string","title":"ANSI Bright White","description":"ANSI palette color 15.","pattern":"^#[0-9a-fA-F]{6}$"}
      }
    }
  }
}
