From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chase Haley <chasehaley33@gmail.com>
Date: Wed, 11 Nov 2026 08:08:45 -0600
Subject: [PATCH 1/2] terminal: batch printing without wraparound

ConPTY turns autowrap off (CSI ? 7 l) in every session, and printSlice
then fell back to print() for every codepoint. The batched fills now
stop at the right margin when wraparound is off. printSliceBatched
prints a run of narrow codepoints that lands on the last cell as its
last codepoint alone, which is all print() leaves there.

The printSlice differential fuzz now also runs without wraparound.

On an i9-14900K, ManyLine output recorded from ConPTY parses at
170 MB/s instead of 100 MB/s, and LongLine at 3.9 GB/s instead of
220 MB/s.
---
 src/terminal/Terminal.zig | 118 +++++++++++++++++++++++++++++++++-----
 1 file changed, 103 insertions(+), 15 deletions(-)

diff --git a/src/terminal/Terminal.zig b/src/terminal/Terminal.zig
index 3f311d2..ef537ec 100644
--- a/src/terminal/Terminal.zig
+++ b/src/terminal/Terminal.zig
@@ -628,12 +628,10 @@ fn printSliceOf(self: *Terminal, comptime Cp: type, cps: []const Cp) !void {
         // Only the main display is supported.
         if (self.status_display != .main) break :fast false;
 
-        // Modes that require per-codepoint handling in print().
-        // Wraparound is required (its the default) so that our
-        // row-fill logic below can assume soft-wrap semantics. Insert
-        // mode shifts cells per print.
+        // Modes that require per-codepoint handling in print(). Insert
+        // mode shifts cells per print. Without wraparound the fills stop
+        // at the right margin, and printSliceBatched handles the rest.
         if (self.modes.get(.insert)) break :fast false;
-        if (!self.modes.get(.wraparound)) break :fast false;
 
         // Single shifts require per-codepoint charset handling.
         const screen: *Screen = self.screens.active;
@@ -676,8 +674,28 @@ fn printSliceBatched(
         else => false,
     };
 
+    const wraparound = self.modes.get(.wraparound);
     var i: usize = 0;
     while (i < cps.len) {
+        // Without wraparound, a pending wrap means the cursor is on the
+        // last cell of its row and stays there: print() overwrites that
+        // cell with each codepoint. Programs under ConPTY run this way,
+        // since it turns wraparound off. A narrow codepoint up to 0xFF
+        // never clusters and just replaces the cell, so of a run of them
+        // only the last one shows: print that one alone.
+        if (!wraparound and self.screens.active.cursor.pending_wrap) {
+            var end = i;
+            while (end < cps.len and cps[end] >= 0x10 and cps[end] <= 0xFF) end += 1;
+            if (end > i) {
+                try self.print(@intCast(cps[end - 1]));
+                i = end;
+            } else {
+                try self.print(@intCast(cps[i]));
+                i += 1;
+            }
+            continue;
+        }
+
         // Try the fast-path print first. This will return the number of
         // codepoints it consumed.
         const consumed = try self.printSliceFast(
@@ -1083,7 +1101,12 @@ fn printSliceFill(
     outer: while (printed < run_len) {
         // If we're soft-wrapping, handle that first so that our cursor
         // is in the row/column that will receive the next codepoint.
-        if (screen.cursor.pending_wrap) try self.printWrap();
+        if (screen.cursor.pending_wrap) {
+            // Without wraparound the cursor stays on the last cell; the
+            // caller handles that (see printSliceBatched).
+            if (!self.modes.get(.wraparound)) break;
+            try self.printWrap();
+        }
 
         // Our right margin depends on where our cursor is now,
         // matching the logic in print().
@@ -1132,6 +1155,10 @@ fn printSliceFill(
 
         if (comptime width == .wide) {
             if (avail == 1) {
+                // Without wraparound print() drops a wide codepoint
+                // that doesn't fit, leaving the cursor where it is.
+                if (!self.modes.get(.wraparound)) break;
+
                 // Only one cell left in the row: print() writes a
                 // spacer head (or a blank narrow cell if we're inside
                 // a right margin) and wraps. We require a simple cell,
@@ -1448,6 +1475,10 @@ fn printSliceMixed(
     // ensure that our screen remains in a consistent state.
     defer screen.assertIntegrity();
 
+    // Without wraparound the rows stop at the right margin (see
+    // printSliceBatched).
+    const wraparound = self.modes.get(.wraparound);
+
     // The cell template and expected bits are set per row below.
     var state: PrintSliceMixedRow = .{
         .cps = cps,
@@ -1461,7 +1492,10 @@ fn printSliceMixed(
         // after classifying the codepoint it stops at, so a pending
         // wrap here is followed by an eligible codepoint: print()
         // would wrap for it.
-        if (cursor.pending_wrap) try self.printWrap();
+        if (cursor.pending_wrap) {
+            if (!wraparound) break;
+            try self.printWrap();
+        }
 
         const right_limit: usize = if (cursor.x > self.scrolling_region.right)
             self.cols
@@ -1532,6 +1566,14 @@ fn printSliceMixed(
             stop = state.fill(grapheme_cluster, styled);
         }
 
+        // Without wraparound the wide codepoint at the edge is left to
+        // print(), which drops it, so its cell keeps its style.
+        if (stop == .wide_at_edge and !wraparound) {
+            if (styled and PrintSliceSimpleMask.pattern(state.cells[state.k]) == 0) {
+                state.n_default -= 1;
+            }
+        }
+
         // The cells in the default style we overwrote (or, for
         // wide_at_edge, are about to) each need a reference to our
         // style. Before anything that could clone the page.
@@ -1573,6 +1615,9 @@ fn printSliceMixed(
             // inside a right margin) there and wraps. fill() checked
             // that the cell is simple, in our style or the default one.
             .wide_at_edge => {
+                // Handled by print() (see above).
+                if (!wraparound) break;
+
                 var spacer = template;
                 if (right_limit == self.cols) {
                     cursor.page_row.wrap = true;
@@ -16180,6 +16225,7 @@ fn testPrintSliceDifferential(
     ops: usize,
     cols: size.CellCountInt,
     rows: size.CellCountInt,
+    wraparound: bool,
 ) !void {
     var t1 = try init(io_impl, alloc, .{
         .cols = cols,
@@ -16191,6 +16237,8 @@ fn testPrintSliceDifferential(
         .rows = rows,
     });
     defer t2.deinit(alloc);
+    t1.modes.set(.wraparound, wraparound);
+    t2.modes.set(.wraparound, wraparound);
 
     var cps_buf: [64]u32 = undefined;
     var last_n: usize = 0;
@@ -16654,10 +16702,10 @@ test "Terminal: printSlice differential fuzz vs print" {
     var prng = std.Random.DefaultPrng.init(0xC0FFEE);
     const rand = prng.random();
     const alphabet = &test_print_slice_alphabet;
-    try testPrintSliceDifferential(io_impl, alloc, rand, alphabet, 500, 80, 24);
-    try testPrintSliceDifferential(io_impl, alloc, rand, alphabet, 500, 10, 4);
-    try testPrintSliceDifferential(io_impl, alloc, rand, alphabet, 500, 5, 2);
-    try testPrintSliceDifferential(io_impl, alloc, rand, alphabet, 200, 2, 2);
+    try testPrintSliceDifferential(io_impl, alloc, rand, alphabet, 500, 80, 24, true);
+    try testPrintSliceDifferential(io_impl, alloc, rand, alphabet, 500, 10, 4, true);
+    try testPrintSliceDifferential(io_impl, alloc, rand, alphabet, 500, 5, 2, true);
+    try testPrintSliceDifferential(io_impl, alloc, rand, alphabet, 200, 2, 2, true);
 }
 
 test "Terminal: printSlice differential fuzz vs print, CJK with spaces" {
@@ -16667,10 +16715,50 @@ test "Terminal: printSlice differential fuzz vs print, CJK with spaces" {
     var prng = std.Random.DefaultPrng.init(0xC1C1);
     const rand = prng.random();
     const alphabet = &test_print_slice_cjk_alphabet;
-    try testPrintSliceDifferential(io_impl, alloc, rand, alphabet, 500, 80, 24);
-    try testPrintSliceDifferential(io_impl, alloc, rand, alphabet, 500, 11, 4);
-    try testPrintSliceDifferential(io_impl, alloc, rand, alphabet, 500, 5, 2);
-    try testPrintSliceDifferential(io_impl, alloc, rand, alphabet, 200, 3, 2);
+    try testPrintSliceDifferential(io_impl, alloc, rand, alphabet, 500, 80, 24, true);
+    try testPrintSliceDifferential(io_impl, alloc, rand, alphabet, 500, 11, 4, true);
+    try testPrintSliceDifferential(io_impl, alloc, rand, alphabet, 500, 5, 2, true);
+    try testPrintSliceDifferential(io_impl, alloc, rand, alphabet, 200, 3, 2, true);
+}
+
+test "Terminal: printSlice differential fuzz vs print, without wraparound" {
+    const alloc = testing.allocator;
+    const io_impl = testing.io;
+
+    // ConPTY turns wraparound off, so slices often run past the right
+    // margin and overwrite its last cell.
+    var prng = std.Random.DefaultPrng.init(0x7A17);
+    const rand = prng.random();
+    inline for (.{ &test_print_slice_alphabet, &test_print_slice_cjk_alphabet }) |alphabet| {
+        try testPrintSliceDifferential(io_impl, alloc, rand, alphabet, 500, 80, 24, false);
+        try testPrintSliceDifferential(io_impl, alloc, rand, alphabet, 500, 10, 4, false);
+        try testPrintSliceDifferential(io_impl, alloc, rand, alphabet, 500, 5, 2, false);
+        try testPrintSliceDifferential(io_impl, alloc, rand, alphabet, 200, 2, 2, false);
+    }
+}
+
+test "Terminal: printSlice without wraparound overwrites the last cell" {
+    const alloc = testing.allocator;
+    const io_impl = testing.io;
+    var t1 = try init(io_impl, alloc, .{ .cols = 5, .rows = 2 });
+    defer t1.deinit(alloc);
+    var t2 = try init(io_impl, alloc, .{ .cols = 5, .rows = 2 });
+    defer t2.deinit(alloc);
+    t1.modes.set(.wraparound, false);
+    t2.modes.set(.wraparound, false);
+
+    const cps = [_]u32{ 'a', 'b', 'c', 'd', 'e', 'f', 'g', 0x4E00, 'h', 0xE9, 'i' };
+    for (cps) |cp| try t1.print(@intCast(cp));
+    try t2.printSlice(&cps);
+
+    for ([_]*Terminal{ &t1, &t2 }) |t| {
+        const str = try t.plainString(alloc);
+        defer alloc.free(str);
+        try testing.expectEqualStrings("abcdi", str);
+        try testing.expectEqual(@as(size.CellCountInt, 4), t.screens.active.cursor.x);
+        try testing.expect(t.screens.active.cursor.pending_wrap);
+        try testing.expectEqual(@as(?u21, 'i'), t.previous_char);
+    }
 }
 
