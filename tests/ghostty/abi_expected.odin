package ghostty_test

import "core:testing"
import "aio:ghostty"

@(test)
abi :: proc(t: ^testing.T) {
	testing.expect_value(t, size_of(ghostty.String), 16)
	testing.expect_value(t, align_of(ghostty.String), 8)
	testing.expect_value(t, offset_of(ghostty.String, ptr), 0)
	testing.expect_value(t, offset_of(ghostty.String, len), 8)
