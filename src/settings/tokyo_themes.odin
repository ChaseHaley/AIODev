package settings

// Terminal palettes from folke/tokyonight.nvim extras/kitty (MIT).
@(private)
tokyo_colors :: proc(b: Builtin_Theme) -> Builtin_Colors {
	if b.mode == .Light {return tokyo_day()}
	#partial switch b.name {
	case .Tokyo_Night: return tokyo_night()
	case .Tokyo_Storm: return tokyo_storm()
	case .Tokyo_Moon: return tokyo_moon()
	case: return tokyo_night()
	}
}

